@startuml Campus Survival Archive
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

/' Kevin: core people, item hierarchy, identity, and privacy types '/
package "Domain: People and Inventory" {
  enum StudentRole {
    MEMBER
    COORDINATOR
    STORYTELLER
  }

  enum ItemStatus {
    AVAILABLE
    RESERVED
    ON_LOAN
    RETIRED
  }

  enum ItemCondition {
    NEW
    GOOD
    WORN
    DAMAGED
  }

  abstract class Item {
    - id: UUID {readOnly}
    - name: String
    - description: String
    - condition: ItemCondition
    - status: ItemStatus
    - addedOn: LocalDate
    + Item(id: UUID, name: String, description: String, condition: ItemCondition)
    + getId(): UUID
    + getName(): String
    + setName(name: String): void
    + getCondition(): ItemCondition
    + updateCondition(condition: ItemCondition): void
    + getStatus(): ItemStatus
    + getCategory(): ItemCategory
    + getCareInstructions(): String
    + markOnLoan(): void
    + markAvailable(): void
    + retire(): void
    + equals(other: Object): boolean
    + hashCode(): int
  }

  class AcademicTechItem {
    - accessories: List<String>
    + getCategory(): ItemCategory
    + getCareInstructions(): String
  }

  class DormUtilityItem {
    - safetyInstructions: String
    - safetyCheckRequired: boolean
    + getCategory(): ItemCategory
    + getCareInstructions(): String
  }

  class SocialLeisureItem {
    - eventUseOnly: boolean
    - groupUseAllowed: boolean
    + getCategory(): ItemCategory
    + getCareInstructions(): String
  }

  enum ItemCategory {
    ACADEMIC_TECH
    DORM_UTILITY
    SOCIAL_LEISURE
  }

  class Student {
    - studentId: String {readOnly}
    - name: String
    - dormRoom: String
    - role: StudentRole
    - showNameInLogs: boolean
    + Student(studentId: String, name: String, dormRoom: String, role: StudentRole)
    + getStudentId(): String
    + getName(): String
    + setName(name: String): void
    + getDormRoom(): String
    + setDormRoom(dormRoom: String): void
    + getRole(): StudentRole
    + getDisplayName(requester: Student): String
    + equals(other: Object): boolean
    + hashCode(): int
  }

  interface LoanPolicy {
    + calculateDueDate(item: Item, borrowedOn: LocalDate): LocalDate
    + requiresReservation(item: Item): boolean
  }

  class AcademicLoanPolicy {
    - maxLoanDays: int
    + calculateDueDate(item: Item, borrowedOn: LocalDate): LocalDate
    + requiresReservation(item: Item): boolean
  }

  class UtilityLoanPolicy {
    - maxLoanDays: int
    + calculateDueDate(item: Item, borrowedOn: LocalDate): LocalDate
    + requiresReservation(item: Item): boolean
  }

  class EventLoanPolicy {
    - maxLoanDays: int
    + calculateDueDate(item: Item, borrowedOn: LocalDate): LocalDate
    + requiresReservation(item: Item): boolean
  }

  class PrivacyPolicy {
    - retentionDays: int
    - overdueCoordinatorOnly: boolean
    + canViewLoanDetails(requester: Student): boolean
    + canViewContactInfo(requester: Student): boolean
    + isExpired(loan: Loan, today: LocalDate): boolean
  }

  class StorageSpace {
    - location: String
    - capacity: int
    + hasRoom(): boolean
    + recordPlacement(item: Item): void
    + removePlacement(item: Item): void
  }
}

/' Liron: loans, reservations, lending orchestration, sign-out records, and domain errors '/
package "Domain: Lending" {
  class CampusClub {
    - id: UUID {readOnly}
    - name: String
    - originStory: String
    - members: Map<String, Student>
    - inventory: List<Item>
    - donations: List<Donation>
    - storage: StorageSpace
    - signOutLog: SignOutLog
    - logbook: Logbook
    - requestBoard: RequestBoard
    - lendingService: LendingService
    - catalogService: CatalogService
    - privacyPolicy: PrivacyPolicy
    - {static} clubCount: int
    + CampusClub(id: UUID, name: String, originStory: String)
    + checkOut(student: Student, item: Item): Loan
    + checkOut(student: Student, item: Item, borrowedOn: LocalDate): Loan
    + returnItem(loan: Loan): void
    + returnItem(loan: Loan, condition: ItemCondition): void
    + registerStudent(student: Student): void
    + addItem(item: Item): void
    + acceptDonation(donation: Donation): Item
    + findAvailableItems(category: ItemCategory): List<Item>
    + searchItems(query: String): List<Item>
    + isMember(student: Student): boolean
    + {static} getClubCount(): int
  }

  class LendingService {
    - policyByCategory: Map<ItemCategory, LoanPolicy>
    + checkOut(student: Student, item: Item, borrowedOn: LocalDate): Loan
    + returnItem(loan: Loan, condition: ItemCondition, returnedOn: LocalDate): void
    + reserve(student: Student, item: Item, reservedFor: LocalDate): Reservation
  }

  class CatalogService {
    - inventory: List<Item>
    + search(query: String): List<Item>
    + findAvailable(category: ItemCategory): List<Item>
    + sortByName(items: List<Item>): List<Item>
    + sortByAddedDate(items: List<Item>): List<Item>
  }

  class Loan {
    - id: UUID {readOnly}
    - borrower: Student {readOnly}
    - item: Item {readOnly}
    - borrowedOn: LocalDate {readOnly}
    - dueOn: LocalDate {readOnly}
    - returnedOn: LocalDate [0..1]
    - conditionOnCheckout: ItemCondition {readOnly}
    - conditionOnReturn: ItemCondition [0..1]
    + Loan(id: UUID, borrower: Student, item: Item, borrowedOn: LocalDate, dueOn: LocalDate, conditionOnCheckout: ItemCondition)
    + getBorrower(): Student
    + getItem(): Item
    + getDueOn(): LocalDate
    + getReturnedOn(): Optional<LocalDate>
    + isOverdue(today: LocalDate): boolean
    + close(returnedOn: LocalDate, condition: ItemCondition): void
  }

  class Reservation {
    - id: UUID {readOnly}
    - student: Student {readOnly}
    - item: Item {readOnly}
    - requestedOn: LocalDateTime {readOnly}
    - reservedFor: LocalDate {readOnly}
    - status: ReservationStatus
    + Reservation(id: UUID, student: Student, item: Item, reservedFor: LocalDate)
    + cancel(): void
    + fulfill(): void
  }

  enum ReservationStatus {
    ACTIVE
    CANCELLED
    FULFILLED
    EXPIRED
  }

  class SignOutLog {
    - loans: List<Loan>
    + record(loan: Loan): void
    + findActiveLoans(requester: Student): List<Loan>
    + findOverdue(requester: Student, today: LocalDate): List<Loan>
    + purgeExpired(today: LocalDate): int
    + sortByDueDate(loans: List<Loan>): List<Loan>
    + searchByStudentId(studentId: String): List<Loan>
  }

  class Donation {
    - id: UUID {readOnly}
    - donor: Student {readOnly}
    - itemDescription: String
    - proposedCategory: ItemCategory
    - reportedCondition: ItemCondition
    - donatedOn: LocalDate {readOnly}
    - isAnonymous: boolean
    - acceptedOn: LocalDate [0..1]
    + Donation(id: UUID, donor: Student, itemDescription: String, condition: ItemCondition)
    + accept(): void
    + reject(): void
  }

  class InvalidCheckoutException
  class ItemUnavailableException
  class NotMemberException
  class OverdueLoansException
  class AuthorizationException
}

/' David: community storytelling, board workflow, and archive history '/
package "Domain: Community" {
  class Logbook {
    - entries: List<LegendEntry>
    + addEntry(entry: LegendEntry): void
    + findByItem(itemId: UUID): List<LegendEntry>
    + findByAuthor(studentId: String): List<LegendEntry>
    + sortByWrittenDate(): List<LegendEntry>
  }

  class LegendEntry {
    - id: UUID {readOnly}
    - author: Student {readOnly}
    - item: Item {readOnly}
    - story: String
    - writtenOn: LocalDateTime {readOnly}
    - isAnonymous: boolean
    + LegendEntry(id: UUID, author: Student, item: Item, story: String)
    + getDisplayAuthor(requester: Student): String
    + editStory(story: String): void
  }

  class RequestBoard {
    - notes: List<BoardNote>
    + post(note: BoardNote): void
    + getOpenNotes(): List<BoardNote>
    + findByType(type: NoteType): List<BoardNote>
    + resolve(noteId: UUID, resolvedOn: LocalDateTime): void
  }

  class BoardNote {
    - id: UUID {readOnly}
    - author: Student {readOnly}
    - text: String
    - type: NoteType
    - postedOn: LocalDateTime {readOnly}
    - resolvedOn: LocalDateTime [0..1]
    - isAnonymous: boolean
    + BoardNote(id: UUID, author: Student, text: String, type: NoteType)
    + resolve(resolvedOn: LocalDateTime): void
    + getDisplayAuthor(requester: Student): String
  }

  enum NoteType {
    REQUEST
    SHOUTOUT
  }
}

/' Brian: repository owner; integration, shared contracts, tests, and release validation '/
package "Shared Contracts and Rules" {
  note as OOPTopics
    Encapsulation: private state; validate through public methods.
    Abstraction: CampusClub is the use-case facade; LendingService owns checkout rules.
    Inheritance and overriding: abstract Item with three concrete item types.
    Polymorphism: LoanPolicy implementations are selected by category.
    Python overloading: typing.overload describes signatures; one runtime method uses optional arguments.
    Static: CampusClub.clubCount; keep global mutable state minimal.
    Identity: Student and entities compare by stable IDs.
    Lifecycle: AVAILABLE -> ON_LOAN -> AVAILABLE, or RETIRED; reservations use RESERVED.
    Exceptions: reject non-members, unavailable items, overdue borrowers, and unauthorized views.
    Collections: inventory, members, loans, reservations, stories, and notes.
    Python duck typing: any care provider with get_care_instructions() works; Protocol adds optional static checking without requiring inheritance.
  end note

  note as Rules
    Checkout: member only; item AVAILABLE; no overdue active loans; reservation rules honored.
    Return: close the loan once, snapshot return condition, then update or retire the item.
    Privacy: members see availability; coordinators can see protected loan/contact details.
    Retention: purge or anonymize closed loan records after the configured retention period.
    SRP: catalog search/sort, lending, logging, privacy, and storytelling stay in separate owners.
    Immutability: loan identity, borrower, item, checkout date, due date, and checkout condition never change.
    Date/time: use LocalDate for due dates and LocalDateTime for event timestamps; inject a clock in implementation.
    Method overloads must delegate to one validated implementation, never bypass policy.
  end note
}

Item <|-- AcademicTechItem
Item <|-- DormUtilityItem
Item <|-- SocialLeisureItem
AcademicLoanPolicy ..|> LoanPolicy
UtilityLoanPolicy ..|> LoanPolicy
EventLoanPolicy ..|> LoanPolicy

CampusClub "1" o-- "0..*" Student : members
CampusClub "1" o-- "0..*" Item : inventory
CampusClub "1" o-- "0..*" Donation : donations
CampusClub "1" *-- "1" StorageSpace
CampusClub "1" *-- "1" SignOutLog
CampusClub "1" *-- "1" Logbook
CampusClub "1" *-- "1" RequestBoard
CampusClub "1" *-- "1" LendingService
CampusClub "1" *-- "1" CatalogService
CampusClub "1" *-- "1" PrivacyPolicy

LendingService "1" *-- "1..*" LoanPolicy : strategies
SignOutLog "1" *-- "0..*" Loan
Loan "0..*" --> "1" Student : borrower
Loan "0..*" --> "1" Item : borrowed item
Reservation "0..*" --> "1" Student : reserved by
Reservation "0..*" --> "1" Item : for
Donation "0..*" --> "1" Student : donor
Donation ..> Item : creates one on acceptance (optional, 0..1)
LendingService ..> LoanPolicy : selects by category
LendingService ..> Reservation
LendingService ..> SignOutLog
PrivacyPolicy ..> Student
PrivacyPolicy ..> Loan

Logbook "1" *-- "0..*" LegendEntry
LegendEntry "0..*" --> "1" Student : author
LegendEntry "0..*" --> "1" Item : about
RequestBoard "1" *-- "0..*" BoardNote
BoardNote "0..*" --> "1" Student : author

CampusClub ..> InvalidCheckoutException
CampusClub ..> NotMemberException
LendingService ..> ItemUnavailableException
LendingService ..> OverdueLoansException
SignOutLog ..> AuthorizationException

OOPTopics .. CampusClub
Rules .. LendingService
@enduml
